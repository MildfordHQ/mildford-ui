{
  "name": "@mildford/ui",
  "version": "0.0.1",
  "description": "Mildford UI - Material 3 Expressive design system for control planes and creative tools, on React Aria Components",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:palette": "vite-node --options.deps.inline=@material/material-color-utilities scripts/generate-palette.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "react-aria-components": "^1.22.1"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.7",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-node": "3.2.4",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
